rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeStaff() {
      return signedIn() && currentUser().isStaff == true && currentUser().status == 'active';
    }

    function permitted(permission) {
      return activeStaff() && (currentUser().permissions.hasAny(['*']) || currentUser().permissions.hasAny([permission]));
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'customer' && request.resource.data.isStaff == false && request.resource.data.permissions.size() == 0;
      allow read: if signedIn() && (request.auth.uid == uid || activeStaff());
      allow update: if signedIn() && (
        permitted('admin.full') ||
        (permitted('staff.manage') &&
          request.resource.data.permissions == resource.data.permissions &&
          request.resource.data.isStaff == resource.data.isStaff &&
          request.resource.data.role == resource.data.role) ||
        (request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isStaff == resource.data.isStaff &&
          request.resource.data.permissions == resource.data.permissions &&
          request.resource.data.status == resource.data.status) ||
        (request.auth.uid == uid &&
          resource.data.isStaff == false &&
          request.resource.data.isStaff == true &&
          request.resource.data.role == 'dealer_principal' &&
          request.resource.data.employeeId == 'SMG-0001' &&
          request.resource.data.status == 'active' &&
          request.resource.data.permissions.hasOnly(['*']) &&
          !exists(/databases/$(database)/documents/system/bootstrap) &&
          existsAfter(/databases/$(database)/documents/system/bootstrap) &&
          getAfter(/databases/$(database)/documents/system/bootstrap).data.ownerUid == request.auth.uid)
      );
      allow delete: if permitted('admin.full');
    }

    match /customers/{id} {
      allow read: if activeStaff() || (signedIn() && resource.data.linkedUid == request.auth.uid);
      allow create, update: if permitted('customers.manage') || permitted('sales.manage');
      allow delete: if permitted('admin.full');
    }

    match /vehicles/{id} {
      allow read: if signedIn();
      allow create: if
        permitted('inventory.manage') ||
        permitted('sales.manage') ||
        permitted('finance.manage') ||
        permitted('admin.full') ||
        (permitted('acquisitions.manage') && request.resource.data.sourceAcquisitionId is string);
      allow update: if
        permitted('inventory.manage') ||
        permitted('sales.manage') ||
        permitted('finance.manage') ||
        permitted('admin.full') ||
        (permitted('acquisitions.manage') && resource.data.sourceAcquisitionId is string) ||
        (permitted('service.manage') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'serviceReviewStatus',
            'serviceReviewNotes',
            'serviceInspection',
            'serviceReviewedBy',
            'serviceReviewedByName',
            'reconditioningEstimate',
            'location',
            'updatedAt'
          ]));
      allow delete: if permitted('admin.full');
    }

    match /deals/{id} {
      allow read: if activeStaff() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update: if permitted('deals.manage') || permitted('sales.manage');
      allow delete: if permitted('admin.full');
    }

    match /queue/{id} {
      allow read: if activeStaff();
      allow create, update: if permitted('queue.manage') || permitted('sales.manage') || permitted('service.manage');
      allow delete: if permitted('admin.full');
    }

    match /auditLogs/{id} {
      allow create: if activeStaff();
      allow read: if permitted('audit.view') || permitted('admin.full');
      allow update, delete: if false;
    }


    match /testDrives/{id} {
      allow read: if activeStaff();
      allow create, update: if permitted('sales.manage') || permitted('deals.manage') || permitted('inventory.manage') || permitted('admin.full');
      allow delete: if permitted('admin.full');
    }

    match /notifications/{id} {
      allow read: if activeStaff();
      allow create: if activeStaff();
      allow update: if activeStaff();
      allow delete: if permitted('admin.full');
    }



    match /serviceAppointments/{id} {
      allow read: if activeStaff();
      allow create, update: if permitted('service.manage') || permitted('admin.full');
      allow delete: if permitted('admin.full');
    }

    match /repairOrders/{id} {
      allow read: if activeStaff();
      allow create: if permitted('service.manage') || permitted('admin.full');
      allow update: if
        permitted('service.manage') ||
        permitted('admin.full') ||
        (permitted('parts.manage') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partsTotal', 'estimateTotal', 'status', 'updatedAt']));
      allow delete: if permitted('admin.full');
    }

    match /parts/{id} {
      allow read: if activeStaff();
      allow create, update: if permitted('parts.manage') || permitted('admin.full');
      allow delete: if permitted('admin.full');
    }

    match /partRequests/{id} {
      allow read: if activeStaff();
      allow create: if permitted('service.manage') || permitted('parts.manage') || permitted('admin.full');
      allow update: if permitted('parts.manage') || permitted('service.manage') || permitted('admin.full');
      allow delete: if permitted('admin.full');
    }

    match /vehicleAcquisitions/{id} {
      allow read: if
        activeStaff() ||
        (signedIn() && resource.data.sellerUid == request.auth.uid);

      allow create: if
        permitted('acquisitions.manage') ||
        permitted('sales.manage') ||
        permitted('inventory.manage') ||
        permitted('admin.full') ||
        (signedIn() &&
          request.resource.data.sellerUid == request.auth.uid &&
          request.resource.data.status == 'submitted' &&
          request.resource.data.offerAmount == 0);

      allow update: if
        permitted('acquisitions.manage') ||
        permitted('sales.manage') ||
        permitted('inventory.manage') ||
        permitted('admin.full') ||
        (signedIn() &&
          resource.data.sellerUid == request.auth.uid &&
          resource.data.status == 'offer_made' &&
          request.resource.data.status in ['accepted', 'declined', 'review_requested'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'customerResponse',
            'customerResponseNote',
            'respondedAt',
            'updatedAt'
          ]));

      allow delete: if permitted('admin.full');
    }

    match /tradeIns/{id} {
      allow read: if activeStaff();
      allow create: if permitted('sales.manage') || permitted('deals.manage') || permitted('inventory.manage') || permitted('admin.full');
      allow update: if
        permitted('admin.full') ||
        permitted('deals.approve') ||
        ((permitted('sales.manage') || permitted('deals.manage')) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'managerApprovedAcv',
            'managerApprovedAllowance',
            'managerApprovedBy',
            'managerApprovedByName',
            'managerCounterAcv',
            'managerCounterAllowance',
            'managerCounteredBy',
            'managerCounteredByName'
          ]) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['managerApprovalStatus']) ||
            request.resource.data.managerApprovalStatus in ['not_submitted', 'pending'])) ||
        (permitted('inventory.manage') &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'managerApprovalStatus',
            'managerApprovedAcv',
            'managerApprovedAllowance',
            'managerApprovedBy',
            'managerApprovedByName',
            'managerCounterAcv',
            'managerCounterAllowance',
            'managerCounteredBy',
            'managerCounteredByName'
          ])) ||
        (permitted('finance.manage') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'inventoryVehicleId',
            'receivedBy',
            'receivedByName',
            'updatedAt'
          ])) ||
        (permitted('service.manage') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'serviceReviewStatus',
            'serviceReviewNotes',
            'reconditioningEstimate',
            'serviceInspection',
            'serviceReviewedBy',
            'serviceReviewedByName',
            'updatedAt'
          ]));
      allow delete: if permitted('admin.full');
    }



    match /financeCustomerProfiles/{id} {
      allow read, create, update: if permitted('finance.manage') || permitted('admin.full');
      allow delete: if permitted('admin.full');
    }

    match /financeAppointments/{id} {
      allow read: if
        activeStaff() ||
        (signedIn() && resource.data.requesterUid == request.auth.uid);

      allow create: if
        permitted('finance.manage') ||
        permitted('admin.full') ||
        (signedIn() &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == 'requested');

      allow update: if
        permitted('finance.manage') ||
        permitted('admin.full') ||
        (signedIn() &&
          resource.data.requesterUid == request.auth.uid &&
          resource.data.status in ['requested', 'confirmed'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'cancellationNote',
            'cancelledAt',
            'updatedAt'
          ]));

      allow delete: if permitted('admin.full');
    }

    match /financeApplications/{id} {
      allow read: if activeStaff();
      allow create, update: if permitted('finance.manage') || permitted('admin.full');
      allow delete: if permitted('admin.full');
    }

    match /deliveries/{id} {
      allow read: if activeStaff();
      allow create, update: if permitted('finance.manage') || permitted('sales.manage') || permitted('admin.full');
      allow delete: if permitted('admin.full');
    }

    match /system/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() &&
        !exists(/databases/$(database)/documents/system/bootstrap) &&
        request.resource.data.ownerUid == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStaff == true &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dealer_principal' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.hasOnly(['*']);
      allow update, delete: if permitted('admin.full');
    }

    match /system/{id} {
      allow read, write: if permitted('admin.full');
    }
  }
}
